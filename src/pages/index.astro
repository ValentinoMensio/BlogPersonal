---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	CONTACT_EMAIL,
	CONTACT_PHONE,
	GITHUB_URL,
	LINKEDIN_URL,
	SITE_DESCRIPTION,
	SITE_TITLE,
} from '../consts';

const projects = [
	{
		name: 'Granalia',
		role: 'Desarrollador Full Stack',
		description:
			'Sistema web de facturacion y gestion operativa para una fabrica: clientes, productos, transportes, listas de precios, facturas PDF, roles y estadisticas.',
		stack: ['FastAPI', 'React', 'PostgreSQL', 'Docker', 'Caddy'],
	},
	{
		name: 'BeLeadAI',
		role: 'Desarrollador de Software',
		description:
			'Plataforma de automatizacion de prospeccion en Instagram con scraping, orquestacion de tareas, extension Chrome y mensajes personalizados con IA.',
		stack: ['Python', 'Selenium', 'LLMs', 'Chrome MV3', 'APIs'],
	},
	{
		name: 'El Switcher',
		role: 'Backend Developer y Scrum Master',
		description:
			'Plataforma web multijugador para un juego de mesa, desarrollada en equipo con metodologia Scrum, WebSockets, testing y arquitectura backend.',
		stack: ['FastAPI', 'WebSockets', 'React', 'Pytest', 'Vitest'],
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Desarrollador de Software Backend</p>
				<h1>Valentino Mensio</h1>
				<p class="lead">
					Construyo sistemas backend, automatizaciones y herramientas web orientadas a resolver
					problemas reales: APIs, scraping, jobs, generacion de documentos, dashboards operativos y
					automatizacion con IA.
				</p>
				<div class="actions">
					<a class="button primary" href="/projects">Ver proyectos</a>
					<a class="button" href={`mailto:${CONTACT_EMAIL}`}>Contactarme</a>
				</div>
			</section>

			<section class="section split">
				<div>
					<p class="eyebrow">Perfil</p>
					<h2>Backend, automatizacion y sistemas end-to-end.</h2>
				</div>
				<p>
					Soy Analista en Computacion por FAMAF y estudiante de Licenciatura en Ciencias de la
					Computacion. Me especializo en arquitecturas backend, APIs, scraping, automatizacion de
					navegadores y despliegues con Docker. Me interesan los sistemas escalables, la
					arquitectura backend y la automatizacion aplicada con IA.
				</p>
			</section>

			<section class="section">
				<div class="section-heading">
					<p class="eyebrow">Trabajos destacados</p>
					<h2>Proyectos con foco tecnico y uso real.</h2>
				</div>
				<div class="card-grid">
					{
						projects.map((project) => (
							<article class="card project-card">
								<p class="role">{project.role}</p>
								<h3>{project.name}</h3>
								<p>{project.description}</p>
								<ul class="tag-list">
									{project.stack.map((item) => <li>{item}</li>)}
								</ul>
							</article>
						))
					}
				</div>
			</section>

			<section class="section contact-card">
				<div>
					<p class="eyebrow">Contacto</p>
					<h2>Disponible para conversar sobre proyectos backend, automatizacion y software web.</h2>
				</div>
				<div class="contact-links">
					<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
					<a href={`tel:${CONTACT_PHONE.replaceAll(' ', '')}`}>{CONTACT_PHONE}</a>
					<a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
					<a href={LINKEDIN_URL} target="_blank" rel="noreferrer">LinkedIn</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 4rem 0 2rem;
	}
	.hero h1 {
		letter-spacing: -0.06em;
		margin-bottom: 1rem;
	}
	.hero .lead {
		max-width: 820px;
	}
	.actions,
	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
	.button,
	.contact-links a {
		border: 1px solid rgba(var(--gray), 0.28);
		border-radius: 999px;
		color: rgb(var(--gray-dark));
		font-weight: 700;
		padding: 0.65rem 1rem;
		text-decoration: none;
	}
	.button.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: white;
	}
	.split {
		align-items: start;
		display: grid;
		gap: 2rem;
		grid-template-columns: 0.85fr 1.15fr;
	}
	.section-heading {
		max-width: 740px;
		margin-bottom: 1.5rem;
	}
	.role {
		color: var(--accent-dark);
		font-size: 0.9rem;
		font-weight: 700;
		margin: 0 0 0.5rem;
	}
	.project-card h3 {
		margin-bottom: 0.75rem;
	}
	.contact-card {
		background: #111827;
		border-radius: 24px;
		color: white;
		padding: 2rem;
	}
	.contact-card h2,
	.contact-card .eyebrow {
		color: white;
	}
	.contact-links a {
		border-color: rgba(255, 255, 255, 0.2);
		color: white;
	}
	@media (max-width: 720px) {
		.hero {
			padding-top: 2rem;
		}
		.split {
			grid-template-columns: 1fr;
		}
	}
</style>
