---
import { Image } from 'astro:assets';
import ProfileImage from '../assets/profile.jpeg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import GitHubContributions from '../components/GitHubContributions.astro';
import {
	CONTACT_EMAIL,
	CONTACT_PHONE,
	GITHUB_URL,
	LINKEDIN_URL,
	SITE_DESCRIPTION,
	SITE_TITLE,
	SITE_URL,
} from '../consts';
import {
	AVAILABILITY,
	HIGHLIGHTS,
	LOCATION,
	PROJECTS,
	QUICK_FACTS,
	ROLE_TITLE,
	WORK_PRINCIPLES,
} from '../data/profile';

import { CV_URL, CV_DOWNLOAD_NAME } from '../lib/cv-url';

const featured = PROJECTS.filter((project) => project.featured);
const others = PROJECTS.filter((project) => !project.featured);

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Valentino Mensio',
	jobTitle: ROLE_TITLE,
	url: SITE_URL,
	email: `mailto:${CONTACT_EMAIL}`,
	address: { '@type': 'PostalAddress', addressLocality: 'Córdoba', addressCountry: 'AR' },
	alumniOf: { '@type': 'CollegeOrUniversity', name: 'FAMAF - Universidad Nacional de Córdoba' },
	knowsAbout: ['Python', 'FastAPI', 'PostgreSQL', 'React', 'TypeScript', 'Docker', 'Arquitectura de software', 'Diseño de APIs'],
	sameAs: [GITHUB_URL, LINKEDIN_URL],
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${SITE_TITLE} · ${ROLE_TITLE}`} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	</head>
	<body>
		<div class="page-wrapper">
			<Header />
			<main>
				<section class="hero">
					<p class="availability"><span class="dot" aria-hidden="true"></span>{AVAILABILITY}</p>
					<div class="hero-identity">
						<Image
							src={ProfileImage}
							alt="Valentino Mensio"
							width={148}
							height={148}
							class="profile-photo"
						/>
						<div>
							<p class="eyebrow">{ROLE_TITLE} · {LOCATION}</p>
							<h1>Valentino<br />Mensio</h1>
						</div>
					</div>
					<p class="lead">
						Construyo sistemas web que las empresas usan todos los días. Hoy tengo
						<strong>dos sistemas propios en producción</strong>: uno de gestión y facturación
						electrónica con ARCA para una fábrica de alimentos, y un producto modular de gestión
						comercial con punto de venta. Me ocupo de todo el ciclo: entender el proceso, diseñar el
						backend y la API, construir la interfaz, testear y desplegar.
					</p>
					<div class="actions">
						<a class="btn primary" href={`${SITE_URL}/projects/`}>Ver proyectos</a>
						<a class="btn" href={CV_URL} download={CV_DOWNLOAD_NAME}>Descargar CV (PDF)</a>
						<a class="btn" href="#contacto">Contactarme</a>
					</div>
					<p class="stack-line">
						<span>Python</span>
						<span>FastAPI</span>
						<span>PostgreSQL</span>
						<span>React</span>
						<span>TypeScript</span>
						<span>Docker</span>
						<span>Diseño de APIs</span>
						<span>Testing</span>
					</p>
				</section>

				<section class="highlights" aria-label="Resumen en cifras">
					{
						HIGHLIGHTS.map((item) => (
							<div class="highlight">
								<p class="highlight-value">{item.value}</p>
								<p class="highlight-label">{item.label}</p>
								<p class="highlight-detail">{item.detail}</p>
							</div>
						))
					}
				</section>

				<section class="section audience-grid">
					<article class="card audience-card">
						<p class="eyebrow">Perfil en 30 segundos</p>
						<h2>Para equipos de selección</h2>
						<dl class="facts">
							{
								QUICK_FACTS.map((fact) => (
									<div>
										<dt>{fact.label}</dt>
										<dd>{fact.value}</dd>
									</div>
								))
							}
						</dl>
						<div class="audience-actions">
							<a class="btn primary" href={CV_URL} download={CV_DOWNLOAD_NAME}>Descargar CV</a>
							<a class="btn" href={`${SITE_URL}/about/`}>Trayectoria completa</a>
						</div>
					</article>
					<article class="card audience-card">
						<p class="eyebrow">Para equipos técnicos</p>
						<h2>Dónde está lo interesante</h2>
						<ul class="tech-points">
							<li>
								<strong>Monolito modular con contratos.</strong> 19 dominios que colaboran por
								interfaces públicas, verificadas con tests de arquitectura.
								<a href="/blog/gestion-arquitectura-modular/">Caso Gestión →</a>
							</li>
							<li>
								<strong>Integración fiscal sin duplicados.</strong> WSAA/WSFEv1 con recuperación
								ante timeouts consultando el último comprobante antes de reintentar.
								<a href="/blog/granalia-sistema-facturacion/">Caso Granalia →</a>
							</li>
							<li>
								<strong>Checkout reanudable.</strong> Idempotencia persistente, transacciones
								acotadas y outbox: perder una respuesta no genera un segundo cobro.
							</li>
							<li>
								<strong>Operación real.</strong> Docker, migraciones Alembic, backup automático antes
								de cada actualización, releases versionadas y despliegue detrás de Cloudflare Tunnel.
								<a href="/blog/despliegue-seguro-ubuntu-cloudflared/">Guía de despliegue →</a>
							</li>
						</ul>
					</article>
				</section>

				<section class="section">
					<div class="section-heading">
						<p class="eyebrow">Proyectos destacados</p>
						<h2>Software en producción, con usuarios reales.</h2>
					</div>
					<div class="featured-grid">
						{
							featured.map((project) => (
								<article class="card featured-card">
									<div class="featured-top">
										<p class="role">{project.role}</p>
										<span class="status">{project.statusLabel}</span>
									</div>
									<h3>{project.name}</h3>
									<p class="tagline">{project.tagline}</p>
									<p class="problem">{project.problem}</p>
									<ul class="impact">
										{project.impact.map((item) => <li>{item}</li>)}
									</ul>
									{project.metrics && (
										<ul class="metrics">
											{project.metrics.map((metric) => (
												<li>
													<strong>{metric.value}</strong> {metric.label}
												</li>
											))}
										</ul>
									)}
									<ul class="tag-list">
										{project.stack.slice(0, 8).map((item) => <li>{item}</li>)}
									</ul>
									<a class="case-link" href={project.caseUrl}>Leer caso técnico →</a>
								</article>
							))
						}
					</div>
					<div class="card-grid other-grid">
						{
							others.map((project) => (
								<article class="card project-card">
									<div class="featured-top">
										<p class="role">{project.role}</p>
										<span class="status muted">{project.statusLabel}</span>
									</div>
									<h3>{project.name}</h3>
									<p>{project.tagline}</p>
									<ul class="tag-list">
										{project.stack.slice(0, 6).map((item) => <li>{item}</li>)}
									</ul>
									<a class="case-link" href={project.caseUrl}>Leer caso técnico →</a>
								</article>
							))
						}
						<article class="card project-card all-projects">
							<p class="role">Portfolio</p>
							<h3>Todos los proyectos</h3>
							<p>Problema, solución, resultado y stack de cada proyecto, en una sola página.</p>
							<a class="case-link" href={`${SITE_URL}/projects/`}>Ver proyectos →</a>
						</article>
					</div>
				</section>

				<section class="section">
					<div class="section-heading">
						<p class="eyebrow">Cómo trabajo</p>
						<h2>Criterio técnico y foco en el negocio.</h2>
					</div>
					<div class="card-grid principles">
						{
							WORK_PRINCIPLES.map((principle) => (
								<article class="card">
									<h3>{principle.title}</h3>
									<p>{principle.text}</p>
								</article>
							))
						}
					</div>
				</section>

				<section class="section">
					<GitHubContributions />
				</section>

				<section class="section contact-card" id="contacto">
					<div>
						<p class="eyebrow">Contacto</p>
						<h2>¿Buscás a alguien para tu equipo o tenés un sistema para construir?</h2>
						<p>
							Estoy abierto a posiciones Full Stack o Backend y a proyectos de software a medida,
							automatización e integraciones. Respondo por mail o LinkedIn.
						</p>
					</div>
					<div class="contact-links">
						<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
						<a href={`tel:${CONTACT_PHONE.replaceAll(' ', '')}`}>{CONTACT_PHONE}</a>
						<a href={LINKEDIN_URL} target="_blank" rel="noreferrer">LinkedIn</a>
						<a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
						<a href={CV_URL} download={CV_DOWNLOAD_NAME}>CV (PDF)</a>
					</div>
				</section>
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	.page-wrapper {
		position: relative;
		z-index: 10;
	}

	.hero {
		padding: 4.5rem 0 2.5rem;
	}

	.availability {
		align-items: center;
		background: rgba(16, 185, 129, 0.08);
		border: 1px solid rgba(16, 185, 129, 0.25);
		border-radius: 999px;
		color: #6ee7b7;
		display: inline-flex;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		gap: 0.55rem;
		margin: 0 0 1.75rem;
		padding: 0.35rem 0.85rem;
	}

	.dot {
		background: #10b981;
		border-radius: 50%;
		box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.18);
		height: 8px;
		width: 8px;
	}

	.hero-identity {
		align-items: center;
		display: flex;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.hero-identity .eyebrow {
		margin-bottom: 0.6rem;
	}

	.profile-photo {
		aspect-ratio: 1;
		border: 2px solid rgba(148, 163, 184, 0.28);
		border-radius: 50%;
		box-shadow: 0 0 0 8px rgba(99, 102, 241, 0.08), var(--shadow-card);
		flex: 0 0 auto;
		height: clamp(88px, 12vw, 148px);
		object-fit: cover;
		width: clamp(88px, 12vw, 148px);
	}

	.hero h1 {
		font-size: clamp(3.2rem, 9vw, 6rem);
		letter-spacing: -0.05em;
		line-height: 1;
		margin-bottom: 0;
	}

	.hero .lead {
		margin-bottom: 2rem;
		max-width: 900px;
	}

	.hero .lead strong {
		color: var(--text-primary);
		font-weight: 600;
	}

	.stack-line {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 1.75rem 0 0;
		padding: 0;
	}

	.stack-line span {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.stack-line span::before {
		color: var(--accent);
		content: '// ';
		opacity: 0.5;
	}

	.actions,
	.audience-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn {
		align-items: center;
		border: 1px solid var(--border);
		border-radius: 8px;
		color: var(--text-secondary);
		display: inline-flex;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		min-height: 44px;
		padding: 0.6rem 1.2rem;
		text-decoration: none;
		transition: border-color 0.15s, color 0.15s, background 0.15s;
	}

	.btn:hover {
		background: rgba(255, 255, 255, 0.04);
		border-color: var(--border-hover);
		color: var(--text-primary);
	}

	.btn.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}

	.btn.primary:hover {
		background: var(--accent-light);
		border-color: var(--accent-light);
		color: #fff;
	}

	/* Cifras */
	.highlights {
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		display: grid;
		gap: 1px;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin-top: 1rem;
		overflow: hidden;
	}

	.highlight {
		background: var(--bg-surface);
		padding: 1.4rem 1.5rem;
	}

	.highlight p {
		margin: 0;
	}

	.highlight-value {
		color: var(--text-primary);
		font-size: clamp(1.8rem, 3.5vw, 2.4rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.highlight-label {
		color: var(--accent-light);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.06em;
		margin-top: 0.4rem !important;
		text-transform: uppercase;
	}

	.highlight-detail {
		color: var(--text-secondary);
		font-size: 0.86rem;
		line-height: 1.45;
		margin-top: 0.35rem !important;
	}

	/* RRHH / técnico */
	.audience-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.audience-card {
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		display: flex;
		flex-direction: column;
		padding: 2rem;
	}

	.audience-card h2 {
		font-size: 1.5rem;
		margin-bottom: 1.25rem;
	}

	.facts {
		display: grid;
		gap: 0.9rem;
		margin: 0 0 1.75rem;
	}

	.facts div {
		border-bottom: 1px solid var(--border);
		display: grid;
		gap: 1rem;
		grid-template-columns: 7.5rem 1fr;
		padding-bottom: 0.9rem;
	}

	.facts dt {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.06em;
		padding-top: 0.2rem;
		text-transform: uppercase;
	}

	.facts dd {
		color: var(--text-primary);
		font-size: 0.95rem;
		line-height: 1.5;
		margin: 0;
	}

	.audience-actions {
		margin-top: auto;
	}

	.tech-points {
		display: grid;
		gap: 1.1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tech-points li {
		border-left: 2px solid var(--accent-dim);
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.6;
		padding-left: 1rem;
	}

	.tech-points strong {
		color: var(--text-primary);
	}

	.tech-points a {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		margin-left: 0.25rem;
	}

	/* Proyectos */
	.section-heading {
		margin-bottom: 1.75rem;
		max-width: 680px;
	}

	.featured-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-bottom: 1rem;
	}

	.featured-card {
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		display: flex;
		flex-direction: column;
		padding: 2rem;
	}

	.featured-top {
		align-items: flex-start;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		justify-content: space-between;
		margin-bottom: 0.5rem;
	}

	.role {
		color: var(--accent-light);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		margin: 0;
		opacity: 0.85;
		text-transform: uppercase;
	}

	.status {
		background: rgba(16, 185, 129, 0.1);
		border: 1px solid rgba(16, 185, 129, 0.25);
		border-radius: 999px;
		color: #6ee7b7;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		padding: 0.15rem 0.6rem;
		white-space: nowrap;
	}

	.status.muted {
		background: rgba(255, 255, 255, 0.04);
		border-color: var(--border);
		color: var(--text-secondary);
	}

	.featured-card h3,
	.project-card h3 {
		font-size: 1.45rem;
		letter-spacing: -0.02em;
		margin-bottom: 0.4rem;
	}

	.tagline {
		color: var(--text-primary);
		font-size: 1.02rem;
		margin: 0 0 0.9rem;
	}

	.problem {
		color: var(--text-secondary);
		font-size: 0.92rem;
		line-height: 1.6;
		margin: 0;
	}

	.impact {
		color: var(--text-secondary);
		font-size: 0.92rem;
		line-height: 1.55;
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
	}

	.impact li {
		margin-bottom: 0.5rem;
		padding-left: 1.4rem;
		position: relative;
	}

	.impact li::before {
		color: #10b981;
		content: '✓';
		left: 0;
		position: absolute;
	}

	.metrics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
	}

	.metrics li {
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}

	.metrics strong {
		color: var(--text-primary);
		font-size: 1rem;
	}

	.featured-card .case-link {
		margin-top: auto;
		padding-top: 1rem;
	}

	.other-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.project-card p {
		color: var(--text-secondary);
		font-size: 0.92rem;
		line-height: 1.6;
		margin: 0;
	}

	.project-card .role {
		margin: 0;
	}

	.case-link {
		align-items: center;
		display: inline-flex;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		margin-top: 1rem;
		min-height: 44px;
	}

	.case-link:focus-visible {
		outline: 2px solid var(--accent-light);
		outline-offset: 4px;
	}

	.principles {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.principles h3 {
		font-size: 1.05rem;
		margin-bottom: 0.5rem;
	}

	.principles p {
		color: var(--text-secondary);
		font-size: 0.9rem;
		line-height: 1.6;
		margin: 0;
	}

	/* Contacto */
	.contact-card {
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-xl);
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		padding: 2.5rem;
	}

	.contact-card .eyebrow {
		color: var(--accent-light);
	}

	.contact-card h2 {
		color: var(--text-primary);
		font-size: clamp(1.4rem, 3vw, 2rem);
		line-height: 1.25;
		max-width: 640px;
	}

	.contact-card p {
		color: var(--text-secondary);
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.contact-links a {
		border: 1px solid var(--border);
		border-radius: 6px;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.82rem;
		letter-spacing: 0.02em;
		padding: 0.45rem 0.9rem;
		text-decoration: none;
		transition: border-color 0.15s, color 0.15s;
	}

	.contact-links a:hover {
		border-color: var(--accent-light);
		color: var(--accent-light);
	}

	@media (max-width: 960px) {
		.highlights,
		.principles {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.other-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.hero {
			padding-top: 2.5rem;
		}

		.audience-grid,
		.featured-grid,
		.principles {
			grid-template-columns: 1fr;
		}

		.audience-card,
		.featured-card,
		.contact-card {
			padding: 1.5rem;
		}

		.facts div {
			gap: 0.25rem;
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 480px) {
		.hero-identity {
			align-items: flex-start;
			flex-direction: column;
		}

		.highlights {
			grid-template-columns: 1fr;
		}
	}
</style>
