---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	CONTACT_EMAIL,
	CONTACT_PHONE,
	GITHUB_URL,
	LINKEDIN_URL,
	SITE_DESCRIPTION,
	SITE_TITLE,
} from '../consts';

const projects = [
	{
		name: 'Granalia',
		role: 'Full Stack Developer',
		description:
			'Sistema web de facturación y gestión operativa para una fábrica: clientes, productos, transportes, listas de precios, facturas PDF, roles y estadísticas.',
		stack: ['FastAPI', 'React', 'PostgreSQL', 'Docker', 'Caddy'],
	},
	{
		name: 'BeLeadAI',
		role: 'Full Stack Developer',
		description:
			'Plataforma de prospección con backend, automatización, extensión Chrome, contratos de API y experiencia operativa para gestionar leads y mensajes.',
		stack: ['Python', 'Selenium', 'LLMs', 'Chrome MV3', 'APIs'],
	},
	{
		name: 'El Switcher',
		role: 'Full Stack Developer',
		description:
			'Aplicación web multijugador desarrollada en equipo, integrando backend, frontend, WebSockets, testing y coordinación Scrum.',
		stack: ['FastAPI', 'WebSockets', 'React', 'Pytest', 'Vitest'],
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="page-wrapper">
			<Header />
			<main>
				<section class="hero">
					<p class="eyebrow">Desarrollador de Software Full Stack</p>
					<h1>Valentino<br />Mensio</h1>
					<p class="lead">
						Desarrollo productos web completos: interfaces claras, APIs robustas, bases de datos,
						automatizaciones, integraciones y despliegues. Ayudo a transformar procesos, ideas y
						problemas reales en software usable, mantenible y listo para operar.
					</p>
					<div class="actions">
						<a class="btn primary" href="/projects">Ver proyectos</a>
						<a class="btn" href={`mailto:${CONTACT_EMAIL}`}>Contactarme</a>
					</div>
					<p class="stack-line">
						<span>Python</span>
						<span>FastAPI</span>
						<span>React</span>
						<span>Docker</span>
						<span>PostgreSQL</span>
					</p>
				</section>

				<section class="section split">
					<div>
						<p class="eyebrow">Perfil</p>
						<h2>Full-stack, automatización y productos end-to-end.</h2>
					</div>
					<p class="lead">
						Soy Analista en Computación por FAMAF y estudiante de Licenciatura en Ciencias de la
						Computación. Desarrollo productos web completos: desde el modelado de datos y APIs hasta
						interfaces, automatizaciones, integraciones y despliegues. Me enfoco en crear software
						claro para el usuario, sólido a nivel técnico y útil para resolver problemas reales de
						negocio.
					</p>
				</section>

				<section class="section">
					<div class="section-heading">
						<p class="eyebrow">Proyectos destacados</p>
						<h2>Proyectos con foco técnico y uso real.</h2>
					</div>
					<div class="card-grid">
						{
							projects.map((project) => (
								<article class="card project-card">
									<p class="role">{project.role}</p>
									<h3>{project.name}</h3>
									<p>{project.description}</p>
									<ul class="tag-list">
										{project.stack.map((item) => <li>{item}</li>)}
									</ul>
								</article>
							))
						}
					</div>
				</section>

				<section class="section contact-card">
					<div>
						<p class="eyebrow">Contacto</p>
						<h2>Disponible para proyectos full-stack,<br />automatización y software web.</h2>
					</div>
					<div class="contact-links">
						<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
						<a href={`tel:${CONTACT_PHONE.replaceAll(' ', '')}`}>{CONTACT_PHONE}</a>
						<a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
						<a href={LINKEDIN_URL} target="_blank" rel="noreferrer">LinkedIn</a>
					</div>
				</section>
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	.page-wrapper {
		position: relative;
		z-index: 10;
	}

	.hero {
		padding: 5rem 0 2.5rem;
	}

	.hero h1 {
		font-size: clamp(3.2rem, 9vw, 6rem);
		letter-spacing: -0.05em;
		line-height: 1;
		margin-bottom: 1.25rem;
	}

	.hero .lead {
		margin-bottom: 2rem;
		max-width: 720px;
	}

	.stack-line {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 1.75rem 0 0;
		padding: 0;
	}

	.stack-line span {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.stack-line span::before {
		color: var(--accent);
		content: '// ';
		opacity: 0.5;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn {
		align-items: center;
		border: 1px solid var(--border);
		border-radius: 8px;
		color: var(--text-secondary);
		display: inline-flex;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		padding: 0.6rem 1.2rem;
		text-decoration: none;
		transition: border-color 0.15s, color 0.15s, background 0.15s;
	}

	.btn:hover {
		background: rgba(255, 255, 255, 0.04);
		border-color: var(--border-hover);
		color: var(--text-primary);
	}

	.btn.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}

	.btn.primary:hover {
		background: var(--accent-light);
		border-color: var(--accent-light);
		color: #fff;
	}

	.split {
		align-items: start;
		display: grid;
		gap: 3rem;
		grid-template-columns: 0.85fr 1.15fr;
	}

	.split h2 {
		color: var(--text-primary);
		line-height: 1.2;
	}

	.section-heading {
		margin-bottom: 1.75rem;
		max-width: 680px;
	}

	.role {
		color: var(--accent-light);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		margin: 0 0 0.5rem;
		opacity: 0.8;
		text-transform: uppercase;
	}

	.project-card h3 {
		font-size: 1.25rem;
		letter-spacing: -0.02em;
		margin-bottom: 0.6rem;
	}

	.project-card p {
		color: var(--text-secondary);
		font-size: 0.92rem;
		line-height: 1.6;
		margin: 0;
	}

	.contact-card {
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-xl);
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		padding: 2.5rem;
	}

	.contact-card .eyebrow {
		color: var(--accent-light);
	}

	.contact-card h2 {
		color: var(--text-primary);
		font-size: clamp(1.4rem, 3vw, 2rem);
		line-height: 1.25;
		max-width: 640px;
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.contact-links a {
		border: 1px solid var(--border);
		border-radius: 6px;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.82rem;
		letter-spacing: 0.02em;
		padding: 0.45rem 0.9rem;
		text-decoration: none;
		transition: border-color 0.15s, color 0.15s;
	}

	.contact-links a:hover {
		border-color: var(--accent-light);
		color: var(--accent-light);
	}

	@media (max-width: 720px) {
		.hero {
			padding-top: 3rem;
		}

		.split {
			gap: 1.5rem;
			grid-template-columns: 1fr;
		}

		.contact-card {
			padding: 1.5rem;
		}
	}
</style>
