---
import { Image } from 'astro:assets';
import ProfileImage from '../assets/profile.jpeg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	CONTACT_EMAIL,
	CONTACT_PHONE,
	GITHUB_URL,
	LINKEDIN_URL,
	SITE_DESCRIPTION,
	SITE_TITLE,
	SITE_URL,
} from '../consts';

const projects = [
	{
		name: 'Granalia',
		role: 'Full Stack Developer',
		description:
			'Sistema web de facturación y gestión operativa para una fábrica. Centraliza clientes, productos, transportes, listas de precios, emisión de facturas PDF, roles de usuario y estadísticas para ordenar procesos internos y reducir trabajo manual.',
		stack: ['FastAPI', 'React', 'PostgreSQL', 'ARCA', 'Docker', 'Caddy'],
	},
	{
		name: 'BeLeadAI',
		role: 'Full Stack Developer',
		description:
			'Plataforma de prospección y automatización comercial. Desarrollé backend, flujos automatizados, extensión Chrome, contratos de API e interfaz operativa para gestionar leads, mensajes y procesos de outreach.',
		stack: ['FastAPI', 'MySQL', 'Redis', 'Selenium', 'Chrome MV3', 'OpenAI API'],
	},
	{
		name: 'El Switcher',
		role: 'Backend Developer',
		description:
			'Aplicación web multijugador en tiempo real desarrollada en equipo. Participé en la integración de backend, frontend, WebSockets, testing automatizado y dinámica de trabajo Scrum.',
		stack: ['FastAPI', 'WebSockets', 'React', 'Pytest', 'Vitest', 'Scrum'],
	},
];

const contributionWeeks = [
	[0, 1, 0, 2, 1, 0, 1],
	[1, 2, 1, 3, 2, 1, 0],
	[0, 1, 2, 2, 3, 1, 1],
	[2, 3, 1, 0, 2, 2, 1],
	[1, 2, 3, 4, 2, 1, 0],
	[0, 1, 2, 3, 1, 2, 1],
	[2, 2, 3, 1, 4, 2, 1],
	[1, 0, 2, 2, 3, 1, 2],
	[0, 1, 1, 3, 2, 4, 1],
	[2, 3, 2, 1, 0, 2, 3],
	[1, 2, 4, 3, 2, 1, 0],
	[0, 1, 2, 1, 3, 2, 1],
	[2, 3, 4, 2, 1, 0, 2],
	[1, 2, 3, 1, 2, 3, 1],
	[0, 1, 2, 4, 3, 2, 1],
	[2, 1, 0, 2, 3, 1, 2],
	[1, 3, 2, 4, 2, 1, 0],
	[0, 2, 1, 3, 2, 4, 1],
	[2, 3, 1, 2, 0, 1, 2],
	[1, 0, 2, 3, 4, 2, 1],
	[0, 1, 3, 2, 1, 2, 3],
	[2, 4, 3, 1, 2, 0, 1],
	[1, 2, 0, 3, 2, 1, 2],
	[0, 1, 2, 4, 1, 3, 2],
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="page-wrapper">
			<Header />
			<main>
				<section class="hero">
					<p class="eyebrow">Full-Stack Developer & Product Builder</p>
					<div class="hero-identity">
						<Image
							src={ProfileImage}
							alt="Valentino Mensio"
							width={148}
							height={148}
							class="profile-photo"
						/>
						<h1>Valentino<br />Mensio</h1>
					</div>
					<p class="lead">
						Construyo sistemas web completos para automatizar procesos y convertir ideas en productos
						funcionales. Trabajo de punta a punta: backend, frontend, bases de datos, integraciones,
						automatizaciones y despliegue.
					</p>
					<section class="github-contributions" aria-label="Contribuciones de GitHub en 2026">
						<div class="contribution-header">
							<p>396 contributions in the last year</p>
							<span>2026</span>
						</div>
						<div class="contribution-grid" aria-hidden="true">
							{
								contributionWeeks.map((week) => (
									<div class="contribution-week">
										{week.map((level) => <span class={`contribution-cell level-${level}`} />)}
									</div>
								))
							}
						</div>
						<div class="contribution-legend" aria-hidden="true">
							<span>Less</span>
							<span class="contribution-cell level-0"></span>
							<span class="contribution-cell level-1"></span>
							<span class="contribution-cell level-2"></span>
							<span class="contribution-cell level-3"></span>
							<span class="contribution-cell level-4"></span>
							<span>More</span>
						</div>
					</section>
					<div class="actions">
						<a class="btn primary" href={`${SITE_URL}/projects/`}>Ver proyectos</a>
						<a class="btn" href={`mailto:${CONTACT_EMAIL}`}>Contactarme</a>
					</div>
					<p class="stack-line">
						<span>Python</span>
						<span>FastAPI</span>
						<span>React</span>
						<span>PostgreSQL</span>
						<span>Docker</span>
						<span>APIs</span>
						<span>Automatización</span>
					</p>
				</section>

				<section class="section split">
					<div>
						<p class="eyebrow">Perfil</p>
						<h2>Full-stack developer enfocado en automatización, productos internos y software de gestión.</h2>
					</div>
					<p class="lead">
						Soy Analista en Computación por FAMAF y continúo mi formación en Ciencias de la
						Computación. Me especializo en construir herramientas web completas: desde entender el
						problema y modelar los datos hasta desarrollar APIs, interfaces, integraciones,
						automatizaciones y despliegues.
						<br /><br />
						Mi foco es crear software claro para el usuario, sólido a nivel técnico y útil para resolver
						problemas reales de negocio.
					</p>
				</section>

				<section class="section">
					<div class="section-heading">
						<p class="eyebrow">Proyectos destacados</p>
						<h2>Proyectos con foco técnico y uso real.</h2>
					</div>
					<div class="card-grid">
						{
							projects.map((project) => (
								<article class="card project-card">
									<p class="role">{project.role}</p>
									<h3>{project.name}</h3>
									<p>{project.description}</p>
									<ul class="tag-list">
										{project.stack.map((item) => <li>{item}</li>)}
									</ul>
								</article>
							))
						}
					</div>
				</section>

				<section class="section contact-card">
					<div>
						<p class="eyebrow">Contacto</p>
						<h2>¿Tenés un proceso manual, una idea de producto o una herramienta interna para construir?</h2>
						<p>
							Estoy disponible para proyectos full-stack, automatización, integraciones y software web a medida.
						</p>
					</div>
					<div class="contact-links">
						<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
						<a href={`tel:${CONTACT_PHONE.replaceAll(' ', '')}`}>{CONTACT_PHONE}</a>
						<a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
						<a href={LINKEDIN_URL} target="_blank" rel="noreferrer">LinkedIn</a>
					</div>
				</section>
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	.page-wrapper {
		position: relative;
		z-index: 10;
	}

	.hero {
		padding: 5rem 0 2.5rem;
	}

	.hero-identity {
		align-items: center;
		display: flex;
		gap: 1.5rem;
		margin-bottom: 1.25rem;
	}

	.profile-photo {
		aspect-ratio: 1;
		border: 2px solid rgba(148, 163, 184, 0.28);
		border-radius: 50%;
		box-shadow: 0 0 0 8px rgba(99, 102, 241, 0.08), var(--shadow-card);
		flex: 0 0 auto;
		height: clamp(88px, 12vw, 148px);
		object-fit: cover;
		width: clamp(88px, 12vw, 148px);
	}

	.hero h1 {
		font-size: clamp(3.2rem, 9vw, 6rem);
		letter-spacing: -0.05em;
		line-height: 1;
		margin-bottom: 0;
	}

	.hero .lead {
		margin-bottom: 2rem;
		max-width: 720px;
	}

	.github-contributions {
		background: rgba(13, 17, 23, 0.68);
		border: 1px solid var(--border);
		border-radius: 14px;
		box-shadow: var(--shadow-card);
		margin: 0 0 1.5rem;
		max-width: 720px;
		overflow-x: auto;
		padding: 1rem;
	}

	.contribution-header {
		align-items: center;
		display: flex;
		gap: 1rem;
		justify-content: space-between;
		margin-bottom: 0.85rem;
	}

	.contribution-header p,
	.contribution-header span {
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		margin: 0;
	}

	.contribution-header span {
		color: var(--accent-light);
	}

	.contribution-grid {
		display: flex;
		gap: 4px;
		min-width: max-content;
	}

	.contribution-week {
		display: grid;
		gap: 4px;
		grid-template-rows: repeat(7, 10px);
	}

	.contribution-cell {
		border-radius: 2px;
		display: block;
		height: 10px;
		width: 10px;
	}

	.level-0 {
		background: rgba(148, 163, 184, 0.12);
	}

	.level-1 {
		background: rgba(99, 102, 241, 0.35);
	}

	.level-2 {
		background: rgba(99, 102, 241, 0.58);
	}

	.level-3 {
		background: rgba(129, 140, 248, 0.78);
	}

	.level-4 {
		background: rgba(199, 210, 254, 0.95);
	}

	.contribution-legend {
		align-items: center;
		display: flex;
		gap: 4px;
		justify-content: flex-end;
		margin-top: 0.75rem;
		min-width: max-content;
	}

	.contribution-legend span {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
	}

	.stack-line {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 1.75rem 0 0;
		padding: 0;
	}

	.stack-line span {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.stack-line span::before {
		color: var(--accent);
		content: '// ';
		opacity: 0.5;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn {
		align-items: center;
		border: 1px solid var(--border);
		border-radius: 8px;
		color: var(--text-secondary);
		display: inline-flex;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		padding: 0.6rem 1.2rem;
		text-decoration: none;
		transition: border-color 0.15s, color 0.15s, background 0.15s;
	}

	.btn:hover {
		background: rgba(255, 255, 255, 0.04);
		border-color: var(--border-hover);
		color: var(--text-primary);
	}

	.btn.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}

	.btn.primary:hover {
		background: var(--accent-light);
		border-color: var(--accent-light);
		color: #fff;
	}

	.split {
		align-items: start;
		display: grid;
		gap: 3rem;
		grid-template-columns: 0.85fr 1.15fr;
	}

	.split h2 {
		color: var(--text-primary);
		line-height: 1.2;
	}

	.section-heading {
		margin-bottom: 1.75rem;
		max-width: 680px;
	}

	.role {
		color: var(--accent-light);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		margin: 0 0 0.5rem;
		opacity: 0.8;
		text-transform: uppercase;
	}

	.project-card h3 {
		font-size: 1.25rem;
		letter-spacing: -0.02em;
		margin-bottom: 0.6rem;
	}

	.project-card p {
		color: var(--text-secondary);
		font-size: 0.92rem;
		line-height: 1.6;
		margin: 0;
	}

	.contact-card {
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-xl);
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		padding: 2.5rem;
	}

	.contact-card .eyebrow {
		color: var(--accent-light);
	}

	.contact-card h2 {
		color: var(--text-primary);
		font-size: clamp(1.4rem, 3vw, 2rem);
		line-height: 1.25;
		max-width: 640px;
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.contact-links a {
		border: 1px solid var(--border);
		border-radius: 6px;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.82rem;
		letter-spacing: 0.02em;
		padding: 0.45rem 0.9rem;
		text-decoration: none;
		transition: border-color 0.15s, color 0.15s;
	}

	.contact-links a:hover {
		border-color: var(--accent-light);
		color: var(--accent-light);
	}

	@media (max-width: 720px) {
		.hero {
			padding-top: 3rem;
		}

		.split {
			gap: 1.5rem;
			grid-template-columns: 1fr;
		}

		.contact-card {
			padding: 1.5rem;
		}
	}
</style>
