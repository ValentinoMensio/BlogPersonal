---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const projects = [
	{
		name: 'Granalia',
		period: '2025 - actualidad',
		role: 'Desarrollador Full Stack',
		description:
			'Sistema full-stack para digitalizar la gestión comercial de una fábrica: pedidos, clientes, listas de precios, comprobantes PDF, estadísticas y facturación fiscal integrada con ARCA.',
		details: [
			'Reemplacé planillas y procesos manuales por una herramienta operativa centralizada.',
			'Implementé facturación interna y fiscal, roles de usuario, historial y descarga de PDFs.',
			'Diseñé una base mantenible para operar en producción con Docker, Caddy y PostgreSQL.',
		],
		stack: ['FastAPI', 'React', 'PostgreSQL', 'ARCA', 'Docker', 'Caddy'],
		blogUrl: '/blog/granalia-sistema-facturacion/',
	},
	{
		name: 'BeLeadAI',
		period: '2025',
		role: 'Desarrollador de Software',
		description:
			'Producto para convertir Instagram en un canal de prospección: extrae audiencias, analiza perfiles, gestiona destinatarios y automatiza mensajes desde una extensión conectada a una API privada.',
		details: [
			'Construido como plataforma backend + extensión Chrome MV3 para operar flujos comerciales.',
			'Incluye seguimiento de jobs, límites, resultados y actualizaciones de cliente.',
			'Preparado para distribuir versiones con artefactos verificables por GitHub Releases.',
		],
		stack: ['FastAPI', 'MySQL', 'Redis', 'Chrome MV3', 'WebSockets', 'GitHub Releases'],
		blogUrl: '/blog/beleadai-automatizacion-prospeccion/',
	},
	{
		name: 'El Switcher',
		period: '2024',
		role: 'Backend Developer y Scrum Master',
		description:
			'Plataforma web multijugador para jugar online a un juego de mesa, desarrollada en equipo con Scrum durante Ingeniería de Software en FAMAF.',
		details: [
			'Lideré el Sprint 2 como Scrum Master y aporté como desarrollador backend.',
			'Implementé reglas de juego, partidas, validaciones, WebSockets y bugfixes.',
			'El proyecto alcanzó alta cobertura de pruebas y entregas iterativas durante tres sprints.',
		],
		stack: ['FastAPI', 'WebSockets', 'React', 'Pytest', 'Vitest', 'Scrum', 'Jira'],
		blogUrl: '/blog/el-switcher-backend-scrum/',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Proyectos | ${SITE_TITLE}`}
			description="Proyectos personales y académicos de Valentino Mensio: Granalia, BeLeadAI y El Switcher."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-hero">
				<p class="eyebrow">Proyectos</p>
				<h1>Software construido alrededor de problemas concretos.</h1>
				<p class="lead">
					Estos proyectos resumen mi experiencia construyendo herramientas web completas:
					interfaces, APIs, automatización, scraping, testing y despliegues. Incluyen sistemas
					académicos, productos propios y software usado en operación real.
				</p>
			</section>

			<section class="projects-list">
				{
					projects.map((project) => (
						<article class="project-detail card">
							<div class="project-header">
								<div>
									<p class="eyebrow">{project.period}</p>
									<h2>{project.name}</h2>
								</div>
								<p class="role">{project.role}</p>
							</div>
							<p class="description">{project.description}</p>
							<ul class="details">
								{project.details.map((item) => <li>{item}</li>)}
							</ul>
							<ul class="tag-list">
								{project.stack.map((item) => <li>{item}</li>)}
							</ul>
							<a class="case-link" href={project.blogUrl}>Leer caso técnico</a>
						</article>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-hero {
		max-width: 900px;
		padding: 3rem 0 1rem;
	}
	.projects-list {
		display: grid;
		gap: 1.25rem;
		margin-top: 2rem;
	}
	.project-detail {
		padding: 1.5rem;
	}
	.project-header {
		align-items: start;
		display: flex;
		gap: 1rem;
		justify-content: space-between;
	}
	.project-header h2 {
		margin-bottom: 0;
	}
	.role {
		background: var(--accent-dim);
		border: 1px solid rgba(99, 102, 241, 0.2);
		border-radius: 999px;
		color: var(--accent-light);
		font-family: var(--font-mono);
		font-size: 0.88rem;
		font-weight: 500;
		margin: 0;
		padding: 0.4rem 0.7rem;
		white-space: nowrap;
	}
	.description {
		color: var(--text-secondary);
		font-size: 1.12rem;
		max-width: 860px;
	}
	.details {
		color: var(--text-secondary);
		margin: 1rem 0 0;
		padding-left: 1.25rem;
	}
	.details li {
		margin-bottom: 0.4rem;
	}
	.case-link {
		display: inline-flex;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		margin-top: 1.25rem;
		text-transform: uppercase;
	}
	@media (max-width: 720px) {
		.project-header {
			flex-direction: column;
		}
		.role {
			white-space: normal;
		}
	}
</style>
