---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { PROJECTS } from '../data/profile';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Proyectos | ${SITE_TITLE}`}
			description="Proyectos de Valentino Mensio: Gestión y Granalia en producción, BeLeadAI y El Switcher. Problema, solución, resultado y stack de cada uno."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-hero">
				<p class="eyebrow">Proyectos</p>
				<h1>Software construido alrededor de problemas concretos.</h1>
				<p class="lead">
					Cada proyecto está contado igual: qué problema había, qué construí y qué resultado tuvo.
					Dos de ellos están en producción y los usan clientes reales todos los días. Si buscás el
					detalle técnico, cada uno tiene su caso con decisiones de arquitectura.
				</p>
				<nav class="jump" aria-label="Ir a un proyecto">
					{PROJECTS.map((project) => <a href={`#${project.slug}`}>{project.name}</a>)}
				</nav>
			</section>

			<section class="projects-list">
				{
					PROJECTS.map((project) => (
						<article class="project-detail card" id={project.slug}>
							<div class="project-header">
								<div>
									<p class="eyebrow">{project.period}</p>
									<h2>{project.name}</h2>
									<p class="tagline">{project.tagline}</p>
								</div>
								<div class="badges">
									<span class={`status status-${project.status}`}>{project.statusLabel}</span>
									<span class="role">{project.role}</span>
								</div>
							</div>

							<p class="context">{project.context}</p>

							{project.image && (
								<a class="shot" href={project.caseUrl} aria-label={`Ver capturas de ${project.name}`}>
									<Image src={project.image.src} alt={project.image.alt} width={1200} loading="lazy" />
								</a>
							)}

							<div class="story">
								<div>
									<h3>Problema</h3>
									<p>{project.problem}</p>
								</div>
								<div>
									<h3>Qué construí</h3>
									<ul>
										{project.solution.map((item) => <li>{item}</li>)}
									</ul>
								</div>
								<div>
									<h3>Resultado</h3>
									<ul class="impact">
										{project.impact.map((item) => <li>{item}</li>)}
									</ul>
									{project.metrics && (
										<ul class="metrics">
											{project.metrics.map((metric) => (
												<li>
													<strong>{metric.value}</strong> {metric.label}
												</li>
											))}
										</ul>
									)}
								</div>
							</div>

							<ul class="tag-list">
								{project.stack.map((item) => <li>{item}</li>)}
							</ul>
							<a class="case-link" href={project.caseUrl}>Leer caso técnico →</a>
						</article>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-hero {
		max-width: 900px;
		padding: 3rem 0 1rem;
	}
	.jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.5rem;
	}
	.jump a {
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		padding: 0.35rem 0.85rem;
		text-decoration: none;
	}
	.jump a:hover {
		border-color: var(--accent-light);
		color: var(--accent-light);
	}
	.projects-list {
		display: grid;
		gap: 1.25rem;
		margin-top: 2rem;
	}
	.project-detail {
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: 2rem;
		scroll-margin-top: 80px;
	}
	.project-header {
		align-items: start;
		display: flex;
		gap: 1rem;
		justify-content: space-between;
	}
	.project-header h2 {
		margin-bottom: 0.25rem;
	}
	.tagline {
		color: var(--text-primary);
		font-size: 1.1rem;
		margin: 0;
	}
	.badges {
		align-items: flex-end;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.status {
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		padding: 0.25rem 0.7rem;
		white-space: nowrap;
	}
	.status-production {
		background: rgba(16, 185, 129, 0.1);
		border: 1px solid rgba(16, 185, 129, 0.25);
		color: #6ee7b7;
	}
	.status-product,
	.status-academic {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--border);
		color: var(--text-secondary);
	}
	.role {
		background: var(--accent-dim);
		border: 1px solid rgba(99, 102, 241, 0.2);
		border-radius: 999px;
		color: var(--accent-light);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		padding: 0.3rem 0.7rem;
		white-space: nowrap;
	}
	.context {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		margin: 0.75rem 0 0;
	}
	.shot {
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		display: block;
		margin-top: 1.25rem;
		overflow: hidden;
	}
	.shot img {
		aspect-ratio: 16 / 7;
		display: block;
		height: auto;
		object-fit: cover;
		object-position: top left;
		transition: transform 0.3s ease;
		width: 100%;
	}
	.shot:hover img {
		transform: scale(1.015);
	}
	.story {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: 1fr 1.4fr 1fr;
		margin-top: 1.5rem;
	}
	.story h3 {
		color: var(--accent-light);
		font-family: var(--font-mono);
		font-size: 0.76rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		margin-bottom: 0.6rem;
		text-transform: uppercase;
	}
	.story p,
	.story ul {
		color: var(--text-secondary);
		font-size: 0.94rem;
		line-height: 1.6;
		margin: 0;
	}
	.story ul {
		padding-left: 1.1rem;
	}
	.story li {
		margin-bottom: 0.5rem;
	}
	.story .impact {
		list-style: none;
		padding: 0;
	}
	.impact li {
		padding-left: 1.4rem;
		position: relative;
	}
	.impact li::before {
		color: #10b981;
		content: '✓';
		left: 0;
		position: absolute;
	}
	.metrics {
		display: grid;
		gap: 0.4rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		list-style: none;
		margin: 1rem 0 0 !important;
		padding: 0 !important;
	}
	.metrics li {
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: 8px;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		margin: 0;
		padding: 0.5rem 0.6rem;
	}
	.metrics strong {
		color: var(--text-primary);
		display: block;
		font-size: 1.05rem;
	}
	.case-link {
		display: inline-flex;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		margin-top: 1.25rem;
		min-height: 44px;
		align-items: center;
	}
	@media (max-width: 900px) {
		.story {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 720px) {
		.project-detail {
			padding: 1.5rem;
		}
		.project-header {
			flex-direction: column;
		}
		.badges {
			align-items: flex-start;
		}
		.role {
			white-space: normal;
		}
	}
</style>
