---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CONTACT_EMAIL, CONTACT_PHONE, GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Sobre mi | ${SITE_TITLE}`}
			description="Perfil profesional, educacion, habilidades y contacto de Valentino Mensio."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-hero">
				<p class="eyebrow">Sobre mi</p>
				<h1>Software engineer especializado en automatizacion, scraping y sistemas backend.</h1>
				<p class="lead">
					Tengo experiencia disenando y desarrollando arquitecturas end-to-end, incluyendo APIs,
					sistemas de jobs, scraping, automatizacion de navegadores, generacion de PDFs y despliegues
					con Docker.
				</p>
			</section>

			<section class="section resume-grid">
				<article class="card wide">
					<h2>Perfil profesional</h2>
					<p>
						Analista en Computacion por FAMAF, Universidad Nacional de Cordoba, y estudiante de
						Licenciatura en Ciencias de la Computacion. Actualmente desarrollo BeLeadAI, una plataforma
						de lead generation automatizado para Instagram, y Granalia, un sistema web de facturacion y
						gestion operativa usado en fabrica.
					</p>
					<p>
						Me interesan los sistemas escalables, la arquitectura backend, la automatizacion con IA y
						los productos que conectan necesidades reales con software mantenible.
					</p>
				</article>

				<article class="card">
					<h2>Educacion</h2>
					<h3>FAMAF - Universidad Nacional de Cordoba</h3>
					<p>Licenciatura en Ciencias de la Computacion, 2021 - actualidad.</p>
					<h3>Instituto Tecnico Superior El Obraje</h3>
					<p>Tecnico en informatica profesional y personal, 2014 - 2020.</p>
				</article>

				<article class="card">
					<h2>Habilidades</h2>
					<ul class="skills-list">
						<li><strong>Lenguajes:</strong> Python, JavaScript, Java</li>
						<li><strong>Backend & APIs:</strong> FastAPI, Flask, Pydantic, SQLAlchemy</li>
						<li><strong>Automatizacion & Scraping:</strong> Selenium, undetected-chromedriver, selenium-stealth</li>
						<li><strong>Bases de datos:</strong> MySQL, PostgreSQL, MongoDB, Redis</li>
						<li><strong>Infraestructura:</strong> Docker, Docker Compose, Gunicorn, GitHub Actions, Alembic</li>
						<li><strong>Testing:</strong> Pytest, Vitest</li>
						<li><strong>Plataformas:</strong> Jira, Bitbucket, GitHub</li>
						<li><strong>Idiomas:</strong> Ingles basico en actual estudio</li>
					</ul>
				</article>
			</section>

			<section class="section card contact-card">
				<h2>Contacto</h2>
				<div class="contact-links">
					<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
					<a href={`tel:${CONTACT_PHONE.replaceAll(' ', '')}`}>{CONTACT_PHONE}</a>
					<a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
					<a href={LINKEDIN_URL} target="_blank" rel="noreferrer">LinkedIn</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-hero {
		max-width: 920px;
		padding: 3rem 0 1rem;
	}
	.resume-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.wide {
		grid-column: 1 / -1;
	}
	.card h2 {
		font-size: 1.65rem;
	}
	.card h3 {
		font-size: 1.1rem;
		margin-top: 1.25rem;
	}
	.card p,
	.skills-list {
		color: var(--text-secondary);
	}
	.skills-list {
		padding-left: 1.25rem;
	}
	.skills-list li {
		margin-bottom: 0.75rem;
	}
	.contact-card {
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		color: var(--text-primary);
	}
	.contact-card h2 {
		color: var(--text-primary);
	}
	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.contact-links a {
		border: 1px solid var(--border);
		border-radius: 6px;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 500;
		padding: 0.55rem 0.9rem;
		text-decoration: none;
	}
	.contact-links a:hover {
		border-color: var(--accent-light);
		color: var(--accent-light);
	}
	@media (max-width: 720px) {
		.resume-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
