---
import { CONTACT_EMAIL, CONTACT_PHONE, GITHUB_URL, LINKEDIN_URL } from '../consts';

const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Valentino Mensio. Desarrollador de Software.</p>
	<div class="footer-links">
		<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
		<a href={`tel:${CONTACT_PHONE.replaceAll(' ', '')}`}>{CONTACT_PHONE}</a>
		<a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
		<a href={LINKEDIN_URL} target="_blank" rel="noreferrer">LinkedIn</a>
	</div>
</footer>
<style>
	footer {
		padding: 2.5em 1em 4em;
		background: #0f172a;
		color: rgba(255, 255, 255, 0.72);
		text-align: center;
	}
	footer p {
		margin: 0 0 1rem;
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem 1.25rem;
	}
	.footer-links a {
		color: white;
		text-decoration: none;
	}
	.footer-links a:hover {
		text-decoration: underline;
	}
</style>
