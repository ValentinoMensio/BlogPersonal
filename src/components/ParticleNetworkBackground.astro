---
// Fixed particle network canvas behind the page content.
---

<canvas id="particle-canvas" aria-hidden="true"></canvas>

<script>
	(function () {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
		if (!canvas) return;

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const CONFIG = {
			particleColor: 'rgba(148, 163, 184, OPACITY)',
			lineColor: 'rgba(148, 163, 184, OPACITY)',
			particleOpacity: 0.55,
			lineOpacity: 0.18,
			lineOpacityNear: 0.38,
			particleRadius: 1.6,
			particleSpeed: 0.35,
			connectDist: 130,
			mouseDist: 110,
			mousePush: 0.04,
			density: 8500,
			minParticles: 40,
			maxParticles: 130,
		} as const;

		let W = 0;
		let H = 0;
		let dpr = 1;
		let mouse = { x: -9999, y: -9999 };
		let particles: Particle[] = [];
		let raf = 0;
		const isMobile = () => window.innerWidth < 768;

		class Particle {
			x: number;
			y: number;
			vx: number;
			vy: number;

			constructor() {
				this.x = Math.random() * W;
				this.y = Math.random() * H;
				const angle = Math.random() * Math.PI * 2;
				const speed = (Math.random() * 0.5 + 0.5) * CONFIG.particleSpeed;
				this.vx = Math.cos(angle) * speed;
				this.vy = Math.sin(angle) * speed;
			}

			update() {
				if (this.x < 0 || this.x > W) this.vx *= -1;
				if (this.y < 0 || this.y > H) this.vy *= -1;
				this.x = Math.max(0, Math.min(W, this.x + this.vx));
				this.y = Math.max(0, Math.min(H, this.y + this.vy));

				if (!isMobile()) {
					const dx = this.x - mouse.x;
					const dy = this.y - mouse.y;
					const dist = Math.sqrt(dx * dx + dy * dy);

					if (dist < CONFIG.mouseDist && dist > 0) {
						const force = (CONFIG.mouseDist - dist) / CONFIG.mouseDist;
						this.x += (dx / dist) * force * CONFIG.mousePush * 60;
						this.y += (dy / dist) * force * CONFIG.mousePush * 60;
					}
				}
			}

			draw() {
				ctx!.beginPath();
				ctx!.arc(this.x, this.y, CONFIG.particleRadius, 0, Math.PI * 2);
				ctx!.fillStyle = CONFIG.particleColor.replace('OPACITY', String(CONFIG.particleOpacity));
				ctx!.fill();
			}
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			W = window.innerWidth;
			H = window.innerHeight;
			canvas.width = Math.round(W * dpr);
			canvas.height = Math.round(H * dpr);
			canvas.style.width = W + 'px';
			canvas.style.height = H + 'px';
			ctx!.scale(dpr, dpr);

			const area = W * H;
			const count = Math.min(
				CONFIG.maxParticles,
				Math.max(CONFIG.minParticles, Math.floor(area / CONFIG.density)),
			);

			while (particles.length < count) particles.push(new Particle());
			if (particles.length > count) particles.length = count;
			if (isMobile() && particles.length > 50) particles.length = 50;
		}

		function draw() {
			ctx!.clearRect(0, 0, W, H);

			for (let i = 0; i < particles.length; i++) {
				for (let j = i + 1; j < particles.length; j++) {
					const a = particles[i];
					const b = particles[j];
					const dx = a.x - b.x;
					const dy = a.y - b.y;
					const dist = Math.sqrt(dx * dx + dy * dy);

					if (dist > CONFIG.connectDist) continue;

					const dma = Math.hypot(a.x - mouse.x, a.y - mouse.y);
					const dmb = Math.hypot(b.x - mouse.x, b.y - mouse.y);
					const nearCursor = dma < CONFIG.mouseDist * 1.4 || dmb < CONFIG.mouseDist * 1.4;
					const fade = 1 - dist / CONFIG.connectDist;
					const opacity = nearCursor ? CONFIG.lineOpacityNear * fade : CONFIG.lineOpacity * fade;

					ctx!.beginPath();
					ctx!.moveTo(a.x, a.y);
					ctx!.lineTo(b.x, b.y);
					ctx!.strokeStyle = CONFIG.lineColor.replace('OPACITY', opacity.toFixed(3));
					ctx!.lineWidth = 0.8;
					ctx!.stroke();
				}
			}

			for (const p of particles) {
				p.update();
				p.draw();
			}
		}

		function loop() {
			draw();
			raf = requestAnimationFrame(loop);
		}

		window.addEventListener('mousemove', (e) => {
			mouse.x = e.clientX;
			mouse.y = e.clientY;
		});

		window.addEventListener('mouseleave', () => {
			mouse.x = -9999;
			mouse.y = -9999;
		});

		let resizeTimer: ReturnType<typeof setTimeout>;
		window.addEventListener('resize', () => {
			clearTimeout(resizeTimer);
			resizeTimer = setTimeout(() => {
				cancelAnimationFrame(raf);
				ctx!.setTransform(1, 0, 0, 1, 0, 0);
				resize();
				loop();
			}, 120);
		});

		resize();
		loop();
	})();
</script>

<style>
	#particle-canvas {
		display: block;
		inset: 0;
		pointer-events: none;
		position: fixed;
		z-index: 0;
	}
</style>
